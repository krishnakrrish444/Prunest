# All optional. Leave blank to keep ads, analytics and contact details off.
# Values are read at build time (set them in Cloudflare > Workers > Settings > Build > Variables).

# Business identity shown on About / Contact / Privacy / Terms
PUBLIC_BUSINESS_NAME=
PUBLIC_CONTACT_EMAIL=
PUBLIC_BUSINESS_ADDRESS=

# Google AdSense. Client looks like ca-pub-1234567890123456.
# ads.txt is generated only when this is set.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
PUBLIC_ADSENSE_SLOT_IN_CONTENT=

# Ads Portal (house ads). Script URL that fills [data-ad-placement] slots
# named "below-tool" and "in-content".
PUBLIC_ADS_PORTAL_SCRIPT=

# Cloudflare Web Analytics beacon token
PUBLIC_CF_ANALYTICS_TOKEN=
