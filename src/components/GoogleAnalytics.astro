---
// Google Analytics 4. Rendered only when PUBLIC_GOOGLE_ANALYTICS_ID is set,
// and only runs on the live domain so previews and local builds are not counted.
interface Props {
  measurementId: string;
}
const { measurementId } = Astro.props;
---
<script is:inline define:vars={{ measurementId }}>
  if (location.origin === 'https://prunest.com') {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    // Send the path only: never the query string or the #plan= fragment.
    window.gtag('config', measurementId, {
      page_location: location.origin + location.pathname,
      page_referrer: document.referrer ? new URL(document.referrer).origin : '',
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(measurementId);
    document.head.append(s);
  }
</script>
