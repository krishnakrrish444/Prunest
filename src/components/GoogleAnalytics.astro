---
interface Props {
  measurementId: string;
}

const { measurementId } = Astro.props;
---

<section
  data-google-analytics={measurementId}
  aria-label="Analytics preferences"
  class="no-print border-b border-line bg-surface"
  hidden
>
  <div class="wrap flex flex-wrap items-center gap-3 py-3 text-sm">
    <p>Allow Google Analytics to measure visits? <a href="/privacy#analytics">Privacy details</a></p>
    <button type="button" class="btn btn-primary" data-analytics-allow>Allow analytics</button>
    <button type="button" class="btn" data-analytics-decline>Decline analytics</button>
  </div>
</section>

<script>
  type AnalyticsWindow = Window & {
    dataLayer?: unknown[];
  } & Partial<Record<`ga-disable-${string}`, boolean>>;

  const panel = document.querySelector<HTMLElement>('[data-google-analytics]');
  const settings = document.querySelector<HTMLButtonElement>('[data-analytics-settings]');
  const measurementId = panel?.dataset.googleAnalytics;

  if (panel && settings && measurementId && location.origin === 'https://prunest.com') {
    const analyticsWindow = window as AnalyticsWindow;
    const storageKey = 'prunest:analytics';
    const disableKey = `ga-disable-${measurementId}` as const;
    let started = false;
    let preference: string | null = null;

    try {
      preference = localStorage.getItem(storageKey);
    } catch {
      // Analytics stays off until the visitor makes a choice on this page.
    }

    function startAnalytics(id: string) {
      analyticsWindow[disableKey] = false;
      if (started) return;
      started = true;

      const dataLayer = analyticsWindow.dataLayer ??= [];
      function gtag(..._args: unknown[]) {
        dataLayer.push(arguments);
      }

      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      gtag('consent', 'update', { analytics_storage: 'granted' });
      gtag('js', new Date());
      gtag('config', id, {
        page_location: location.origin + location.pathname,
        page_referrer: document.referrer ? new URL(document.referrer).origin : '',
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
      document.head.append(script);
    }

    function savePreference(value: 'allowed' | 'declined') {
      try {
        localStorage.setItem(storageKey, value);
      } catch {
        // The choice still applies to the current page.
      }
    }

    settings.hidden = false;
    panel.hidden = preference === 'allowed' || preference === 'declined';
    if (preference === 'allowed') startAnalytics(measurementId);

    settings.addEventListener('click', () => {
      panel.hidden = false;
      panel.querySelector<HTMLButtonElement>('[data-analytics-allow]')?.focus();
    });

    panel.querySelector('[data-analytics-allow]')?.addEventListener('click', () => {
      savePreference('allowed');
      startAnalytics(measurementId);
      panel.hidden = true;
      settings.focus({ preventScroll: true });
    });

    panel.querySelector('[data-analytics-decline]')?.addEventListener('click', () => {
      analyticsWindow[disableKey] = true;
      savePreference('declined');
      for (const cookie of document.cookie.split(';')) {
        const name = cookie.trim().split('=', 1)[0];
        if (name === '_ga' || name.startsWith('_ga_')) {
          document.cookie = `${name}=; Max-Age=0; Path=/; Secure`;
          document.cookie = `${name}=; Max-Age=0; Path=/; Domain=prunest.com; Secure`;
        }
      }
      panel.hidden = true;
      settings.focus({ preventScroll: true });
    });
  }
</script>
