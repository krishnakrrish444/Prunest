---
import '@fontsource/zilla-slab/latin-600.css';
import '@fontsource/zilla-slab/latin-700.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { site, tools, analyticsEnabled } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Path without trailing slash, e.g. "/mulch-calculator". "/" for home. */
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description, path, noindex = false, jsonLd } = Astro.props;
const canonical = site.url + (path === '/' ? '/' : path);
const ogImage = `${site.url}/og.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f2e8" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Prunest: free garden calculators and planners" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {site.adsenseClient && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
    {site.adsPortalScript && <script is:inline async src={site.adsPortalScript}></script>}
    {analyticsEnabled && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}></script>}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="btn btn-primary sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50">Skip to content</a>
    {site.googleAnalyticsId && <GoogleAnalytics measurementId={site.googleAnalyticsId} />}
    <header class="no-print border-b border-line bg-surface">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3">
        <a href="/" class="flex items-center gap-2 text-ink no-underline" aria-label="Prunest home">
          <Logo size={34} />
          <span class="display text-2xl font-bold tracking-tight">Prunest</span>
        </a>
        <nav aria-label="Tools">
          <ul class="-mx-2 flex flex-wrap text-sm font-semibold sm:text-base">
            {tools.map((t) => (
              <li>
                <a href={t.path} class="inline-flex min-h-11 items-center px-2 text-ink no-underline hover:underline" aria-current={path === t.path ? 'page' : undefined}>
                  {t.name.replace(' Calculator', '').replace('Raised Bed ', '')}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="no-print mt-16 border-t border-line bg-surface">
      <div class="wrap grid gap-6 py-8 text-sm sm:grid-cols-3">
        <div>
          <p class="display flex items-center gap-2 text-lg font-bold"><Logo size={24} /> Prunest</p>
          <p class="mt-2 text-muted">{site.tagline}</p>
        </div>
        <nav aria-label="Calculators">
          <p class="font-semibold">Calculators</p>
          <ul class="mt-2 space-y-1">
            {tools.map((t) => <li><a href={t.path}>{t.name}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Site">
          <p class="font-semibold">Site</p>
          <ul class="mt-2 space-y-1">
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            {site.googleAnalyticsId && <li><button type="button" class="underline" data-analytics-settings hidden>Analytics preferences</button></li>}
          </ul>
        </nav>
      </div>
      <div class="wrap pb-8 text-sm text-muted">
        <p>Calculations run in your browser. Results are estimates from the measurements you enter; check them before you buy.</p>
      </div>
    </footer>
  </body>
</html>
